from pathlib import Path
import shutil
import pandas as pd
from IPython.display import display
from google.colab import files

# 1. 기존 결과 엑셀 업로드
uploaded = files.upload()
paths = [Path(name) for name in uploaded if name.lower().endswith(".xlsx")]
if len(paths) != 1:
    raise ValueError("결과 엑셀(.xlsx)을 정확히 1개 업로드해 주세요.")
path = paths[0]

# 제목·설명 행이 있더라도 실제 헤더를 찾아 읽습니다.
def read_table(sheet, required):
    raw = pd.read_excel(path, sheet_name=sheet, header=None)
    for i, row in raw.iterrows():
        values = set(row.dropna().astype(str).str.strip())
        if set(required).issubset(values):
            table = pd.read_excel(path, sheet_name=sheet, header=i)
            table.columns = table.columns.astype(str).str.strip()
            return table.dropna(subset=required, how="all")
    raise ValueError(f"{sheet}: 필요한 열 {required}을 찾지 못했습니다.")

keys = ["대상", "종류", "업종"]
group_keys = ["대상", "종류"]

rank = read_table(
    "실제예측3축순위",
    keys + ["실제3축순위", "분석범위검토"]
)
epi = read_table(
    "에피소드3축",
    keys + ["에피소드", "실제판정"]
)

for df in [rank, epi]:
    for col in keys:
        if df[col].isna().any():
            raise ValueError(f"{col}에 결측값이 있습니다.")
        df[col] = df[col].astype(str).str.strip()

if rank.duplicated(keys).any():
    raise ValueError("업종별 시즌 순위에 중복 행이 있습니다.")
if epi["에피소드"].isna().any():
    raise ValueError("사건 번호에 결측값이 있습니다.")
if epi.duplicated(keys + ["에피소드"]).any():
    raise ValueError("같은 업종·사건에 중복 행이 있습니다.")

# 기존 판정을 사용합니다. 감소 기준을 새로 계산하지 않습니다.
epi["실제판정"] = epi["실제판정"].astype("string").str.strip()

counts = epi.groupby(keys, as_index=False).agg(
    전체사건수=("에피소드", "nunique"),
    감소사건수=("실제판정", lambda s: int(s.eq("감소").sum())),
    계산불가사건수=(
        "실제판정",
        lambda s: int(s.fillna("").str.replace(" ", "").eq("계산불가").sum())
    ),
    판정결측사건수=("실제판정", lambda s: int(s.isna().sum()))
)

# 업종별로 해당 지역·기상의 전체 사건이 모두 기록됐는지 확인합니다.
expected = (
    epi.groupby(group_keys)["에피소드"]
    .nunique().rename("지역기상전체사건수").reset_index()
)
counts = counts.merge(expected, on=group_keys, validate="many_to_one")

if counts["전체사건수"].ne(counts["지역기상전체사건수"]).any():
    raise ValueError(
        "일부 업종의 사건 행이 누락돼 있습니다. "
        "분모가 달라질 수 있으므로 원자료를 확인해 주세요."
    )

rank["실제3축순위"] = pd.to_numeric(
    rank["실제3축순위"], errors="raise"
)

# 공동순위를 포함해 기존 실제 10위 이내만 사용
base = rank.loc[rank["실제3축순위"].le(10)].copy()
base = base.merge(counts, on=keys, how="left", validate="one_to_one")

if base["전체사건수"].isna().any():
    raise ValueError("실제 상위 업종 중 사건별 결과가 없는 업종이 있습니다.")

# 보류 열의 값을 명시적으로 해석하고, 모르는 값은 중단합니다.
def parse_bool(series):
    normalized = series.astype("string").str.strip().str.lower()
    mapping = {
        "true": True, "1": True, "1.0": True,
        "false": False, "0": False, "0.0": False
    }
    parsed = normalized.map(mapping)
    if parsed.isna().any():
        unknown = series.loc[parsed.isna()].unique()
        raise ValueError(f"분석범위검토 값 확인 필요: {unknown}")
    return parsed.astype(bool)

base["범위검토보류"] = parse_bool(base["분석범위검토"])
base["감소사건비율"] = base["감소사건수"] / base["전체사건수"]
base["감소횟수"] = (
    base["감소사건수"].astype(int).astype(str)
    + "/"
    + base["전체사건수"].astype(int).astype(str)
)

# 2. 변경하는 부분: 반복 감소 비율만 세 조건으로 비교
# 정수 비교를 사용해 경계값을 정확하게 처리합니다.
eligible = base["감소사건수"].ge(2) & ~base["범위검토보류"]

conditions = {
    "50% 이상": base["감소사건수"] * 2 >= base["전체사건수"],
    "50% 초과": base["감소사건수"] * 2 > base["전체사건수"],
    "75% 이상": base["감소사건수"] * 4 >= base["전체사건수"] * 3
}

for label, mask in conditions.items():
    base[label] = eligible & mask

base = base.sort_values(group_keys + ["실제3축순위", "업종"])
labels = list(conditions)

# 3. 조건별 후보 수: 후보가 0개인 조합도 유지
count_table = (
    base.groupby(group_keys, sort=False)[labels]
    .sum().astype(int)
)
count_output = count_table.reset_index()
total = pd.DataFrame([{
    "대상": "합계",
    "종류": "지역·기상·업종 조합",
    **count_table.sum().to_dict()
}])
count_output = pd.concat([count_output, total], ignore_index=True)

print("\n[조건별 후보 수]")
display(count_output)

# 4. 조건별 후보 목록
summary_rows = []
candidate_frames = []

for (region, weather), g in base.groupby(group_keys, sort=False):
    for label in labels:
        selected = g.loc[g[label]].copy()
        summary_rows.append({
            "대상": region,
            "종류": weather,
            "비율조건": label,
            "후보수": len(selected),
            "후보업종": ", ".join(
                selected["업종"] + "(" + selected["감소횟수"] + ")"
            ) or "없음"
        })
        selected["비율조건"] = label
        candidate_frames.append(selected)

summary = pd.DataFrame(summary_rows)
candidates = pd.concat(candidate_frames, ignore_index=True)

print("\n[조건별 후보 목록]")
display(summary)

# 5. 모든 조건에서 유지 / 조건 강화 시 제외
change_rows = []

def format_names(g):
    return ", ".join(g["업종"] + "(" + g["감소횟수"] + ")") or "없음"

for (region, weather), g in base.groupby(group_keys, sort=False):
    change_rows.append({
        "대상": region,
        "종류": weather,
        "모든 조건에서 유지": format_names(
            g.loc[g[labels].all(axis=1)]
        ),
        "50% 초과부터 제외": format_names(
            g.loc[g["50% 이상"] & ~g["50% 초과"]]
        ),
        "75% 이상에서 제외": format_names(
            g.loc[g["50% 초과"] & ~g["75% 이상"]]
        )
    })

changes = pd.DataFrame(change_rows)
print("\n[조건 강화에 따른 변화]")
display(changes)

detail_cols = keys + [
    "실제3축순위", "감소횟수", "감소사건비율",
    "계산불가사건수", "판정결측사건수", "범위검토보류"
] + labels

print("\n[실제 10위 이내 업종 전체 비교]")
display(base[detail_cols])

print("""
※ 기존 감소 판정·3축 계산·순위 산정 기준은 변경하지 않았습니다.
※ 최소 2회 감소 및 분석범위검토 업종 보류 조건을 유지했습니다.
※ 계산 불가 사건도 전체 사건 수에 포함하며, 감소 횟수에는 넣지 않습니다.
※ 합계는 지역·기상·업종 조합 수이며, 고유 업종 수가 아닙니다.
※ 이 분석은 추가 반복성 조건의 민감도 비교입니다.
※ 조건에서 제외돼도 기존 감소 판정이나 취약 순위는 그대로입니다.
""")

# 6. 결과 저장 및 ZIP 다운로드
out = Path("반복감소비율_민감도분석")
out.mkdir(exist_ok=True)

tables = {
    "조건별_후보수.csv": count_output,
    "조건별_후보목록.csv": summary,
    "조건강화_목록변화.csv": changes,
    "실제상위10위이내_전체비교.csv": base[detail_cols],
    "조건별_후보상세.csv": candidates[
        ["비율조건"] + detail_cols
    ]
}

for filename, table in tables.items():
    table.to_csv(out / filename, index=False, encoding="utf-8-sig")

