    "\"\"\"기존 모델을 유지한 재분석. 기본 경로는 이 코드의 상위 폴더입니다.\"\"\"\n",
    "from pathlib import Path\n",
    "import argparse, os, re, time, warnings, json, hashlib\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import lightgbm as lgb\n",
    "from scipy.stats import spearmanr\n",
    "warnings.filterwarnings('ignore', category=FutureWarning)\n",
    "p=argparse.ArgumentParser()\n",
    "p.add_argument('--root',type=Path,default=Path('/content/reanalysis'))\n",
    "args=p.parse_args(['--root','/content/reanalysis']);ROOT=args.root;OUT=ROOT/'results';OUT.mkdir(exist_ok=True,parents=True)\n",
    "V4_PATH=ROOT/'inputs'/'38_최종baseline_V4.csv'\n",
    "WEATHER_PATH=ROOT/'inputs'/'강남_춘천_기상데이터_병합(6).csv'\n",
    "OUT_DIR=str(OUT)\n",
    "def display(*a): pass\n",
    "\n",
    "\n",
    "# ---- 노션: 2단계 특수일 (공휴일 포함 연속 휴일 구간 ±1일) ----\n",
    "SPECIAL2 = {'광복절': ('2025-08-14', '2025-08-18'), '개천절·추석·한글날': ('2025-10-02', '2025-10-10'),\n",
    "            '성탄절': ('2025-12-24', '2025-12-26')}\n",
    "SPECIAL2_DAYS = pd.DatetimeIndex(np.concatenate([pd.date_range(a, b) for a, b in SPECIAL2.values()]))\n",
    "\n",
    "# ---- 노션: 분석 범위 검토 업종 / 수납 구조 주의 업종 (표시만, 제외하지 않음) ----\n",
    "SCOPE_CHECK = ['보험', '통신요금(이동,시내전화)', '결제대행(PG)']\n",
    "PAYMENT_CAUTION = ['유치원', '학원/학습지']\n",
    "\n",
    "# ---- 평시 범위 / 3축 설정 ----\n",
    "N_DRAW = 300                 # 평시 무작위 추출 횟수\n",
    "RANGE_Q = (5, 95)            # 90% 범위\n",
    "IMPACT_WIN = 3               # Impact 이동평균 일수\n",
    "REC_FLOOR, REC_Q = -0.10, 25 # 회복 기준선 = min(−10%, 업종 평시 하루 y 하위 25%)\n",
    "REC_MAX = 14                 # 회복을 최대 며칠까지 셀지\n",
    "SEED = 42\n",
    "\n",
    "# ---- 모델 ----\n",
    "N_FOLDS, BUFFER = 5, 3       # V4와 같은 ISO 주차 % 5, 예측 주 ±3일 학습 제외\n",
    "LGB_BASE = dict(n_estimators=400, learning_rate=0.03, num_leaves=31, min_child_samples=200,\n",
    "                subsample=0.8, subsample_freq=1, colsample_bytree=0.8, reg_lambda=1.0,\n",
    "                cat_smooth=50, random_state=SEED, verbose=-1, n_jobs=4)\n",
    "OBJECTIVES = {'L2': dict(objective='regression'), 'L1': dict(objective='regression_l1'),\n",
    "              'Huber': dict(objective='huber', alpha=0.1)}\n",
    "pd.set_option('display.width', 250); pd.set_option('display.max_columns', 40)\n",
    "\n",
    "P = pd.read_csv(V4_PATH, encoding='utf-8-sig', parse_dates=['날짜'])\n",
    "P['특수일2'] = P['날짜'].isin(SPECIAL2_DAYS)\n",
    "P['특보일'] = (P['폭염등급'] > 0) | (P['호우등급'] > 0)\n",
    "print(f'V4 {len(P):,}행, 업종 {P[\"gkey\"].nunique()}개, 기간 {P[\"날짜\"].min().date()} ~ {P[\"날짜\"].max().date()}')\n",
    "dd = P.drop_duplicates(['대상', '날짜'])\n",
    "print('2단계 특수일로 빠지는 날:', dd[dd['특수일2']].groupby('대상').size().to_dict(),\n",
    "      '/ 그중 폭염일:', dd[dd['특수일2'] & (dd['폭염등급'] > 0)].groupby('대상').size().to_dict(),\n",
    "      '/ 호우일:', dd[dd['특수일2'] & (dd['호우등급'] > 0)].groupby('대상').size().to_dict())\n",
    "\n",
    "# 하루 단위(지역×업종×날짜) 집계 — 휴무 칸은 실제·baseline 모두 뺌\n",
    "D = (P[~P['휴무']].groupby(['대상', '업종', 'gkey', '날짜'])\n",
    "     .agg(S=('S', 'sum'), B=('B', 'sum'), 폭염등급=('폭염등급', 'max'), 호우등급=('호우등급', 'max'),\n",
    "          평시=('평시', 'first'), 특수일2=('특수일2', 'first')).reset_index())\n",
    "D['y_day'] = (D['S'] - D['B']) / D['B'].replace(0, np.nan)\n",
    "D['요일'] = D['날짜'].dt.dayofweek\n",
    "POOL = D['평시'] & ~D['특수일2']            # 평시 범위 추출 풀\n",
    "\n",
    "vol = D[POOL].groupby('gkey')['S'].agg(lambda s: (s.quantile(.75) - s.quantile(.25)) / s.median() if s.median() > 0 else np.nan)\n",
    "VOL = pd.DataFrame({'IQR/중앙값': vol})\n",
    "VOL['변동성등급'] = pd.qcut(VOL['IQR/중앙값'].rank(method='first'), 3, labels=['저변동', '중변동', '고변동'])\n",
    "VOL['분석범위검토'] = [g.split('|')[1] in SCOPE_CHECK for g in VOL.index]\n",
    "VOL['수납구조주의'] = [g.split('|')[1] in PAYMENT_CAUTION for g in VOL.index]\n",
    "P = P.join(VOL[['변동성등급']], on='gkey'); D = D.join(VOL, on='gkey')\n",
    "print('변동성 등급 경계(IQR/중앙값):', VOL.groupby('변동성등급')['IQR/중앙값'].agg(['min', 'max']).round(3).to_dict('index'))\n",
    "display(VOL.sort_values('IQR/중앙값', ascending=False).head(10).round(3))\n",
    "\n",
    "W = pd.read_csv(WEATHER_PATH, encoding='utf-8-sig', parse_dates=['일시'])\n",
    "W['날짜'] = W['일시'].dt.normalize(); W['hour'] = W['일시'].dt.hour\n",
    "SLOTS = sorted(P['slot'].unique(), key=lambda s: int(re.findall(r'\\d+', s)[0]))\n",
    "starts = [int(re.findall(r'\\d+', s)[0]) for s in SLOTS]\n",
    "W['slot'] = W['hour'].map(lambda h: SLOTS[max(i for i, s in enumerate(starts) if s <= h)])\n",
    "WS = W.groupby(['대상', '날짜', 'slot']).agg(시간대습도=('습도(%)', 'mean'), 시간대풍속=('풍속(m/s)', 'mean')).reset_index()\n",
    "\n",
    "CAL = pd.MultiIndex.from_product([sorted(P['대상'].unique()), pd.date_range(P['날짜'].min(), P['날짜'].max())],\n",
    "                                 names=['대상', '날짜']).to_frame(index=False)\n",
    "rain = W.groupby(['대상', '날짜'])['강수량(mm)'].sum().rename('r')\n",
    "CAL = CAL.join(rain, on=['대상', '날짜'])\n",
    "CAL['전3일강수'] = CAL.groupby('대상')['r'].transform(lambda s: s.shift(1).rolling(3, min_periods=1).sum())\n",
    "heat = P.drop_duplicates(['대상', '날짜']).set_index(['대상', '날짜'])['폭염등급']\n",
    "CAL['h'] = CAL.set_index(['대상', '날짜']).index.map(heat).fillna(0).to_numpy() > 0\n",
    "CAL['폭염연속일수'] = CAL.groupby('대상')['h'].transform(lambda s: s.groupby((~s).cumsum()).cumsum()).astype(int)\n",
    "P = P.merge(WS, on=['대상', '날짜', 'slot'], how='left').merge(CAL[['대상', '날짜', '전3일강수', '폭염연속일수']], on=['대상', '날짜'], how='left')\n",
    "\n",
    "FEATS = ['대상', '업종', 'slot', '시간대최고기온', '시간대강수', '시간대강수시간', '시간대습도', '시간대풍속',\n",
    "         '일최고기온', '일강수', '전3일강수', '폭염연속일수', '폭염등급', '호우등급']\n",
    "for c in ['대상', '업종', 'slot']: P[c] = P[c].astype('category')\n",
    "print('변수', len(FEATS), '개 / 결측 비율:', P[FEATS[3:]].isna().mean().round(4)[lambda s: s > 0].to_dict())\n",
    "\n",
    "M = (~P['휴무']) & (~P['특수일2']) & P['y'].notna()\n",
    "A = P[M].reset_index(drop=True)\n",
    "print(f'2단계 대상 {len(A):,}행 (전체 {len(P):,}행 중) / 특보일 행 {A[\"특보일\"].sum():,}')\n",
    "\n",
    "def fold_masks(f, k):\n",
    "    dates = f['날짜'].values.astype('datetime64[D]'); te = (f['fold'] == k).values\n",
    "    near = np.zeros(len(f), bool)\n",
    "    for o in range(-BUFFER, BUFFER + 1):\n",
    "        near |= np.isin(dates, np.unique(dates[te]) + np.timedelta64(o, 'D'))\n",
    "    return ~near, te\n",
    "FOLDS = {k: fold_masks(A, k) for k in range(N_FOLDS)}\n",
    "\n",
    "def run_cv(params):\n",
    "    pred = np.full(len(A), np.nan); models = {}\n",
    "    for k, (trn, te) in FOLDS.items():\n",
    "        m = lgb.LGBMRegressor(**params).fit(A.loc[trn, FEATS], A.loc[trn, 'y'])\n",
    "        pred[te] = m.predict(A.loc[te, FEATS]); models[k] = m\n",
    "    return pred, models\n",
    "\n",
    "PRED, MODELS = {}, {}\n",
    "t0 = time.time()\n",
    "for name, obj in OBJECTIVES.items():\n",
    "    PRED[name], MODELS[name] = run_cv({**LGB_BASE, **obj})\n",
    "    print(f'{name}: {time.time() - t0:.0f}초')\n",
    "\n",
    "def episodes(region, col):\n",
    "    s = dd[dd['대상'] == region].set_index('날짜')[col].reindex(pd.date_range(P['날짜'].min(), P['날짜'].max())).fillna(0) > 0\n",
    "    out, cur = [], []\n",
    "    for d, v in s.items():\n",
    "        if v: cur.append(d)\n",
    "        elif cur: out.append(cur); cur = []\n",
    "    if cur: out.append(cur)\n",
    "    return out\n",
    "EP = []\n",
    "for reg in sorted(P['대상'].unique()):\n",
    "    for typ, col in [('폭염', '폭염등급'), ('호우', '호우등급')]:\n",
    "        for i, days in enumerate(episodes(reg, col), 1):\n",
    "            EP.append({'대상': reg, '종류': typ, '에피소드': f'{typ}{i}', '시작': days[0], '종료': days[-1],\n",
    "                       '전체일수': len(days), '날짜': days, '분석일': [d for d in days if d not in SPECIAL2_DAYS]})\n",
    "EP = pd.DataFrame(EP)\n",
    "display(EP.assign(분석일수=EP['분석일'].map(len), 시작=EP['시작'].dt.strftime('%m/%d'), 종료=EP['종료'].dt.strftime('%m/%d'))\n",
    "        [['대상', '종류', '에피소드', '시작', '종료', '전체일수', '분석일수']])\n",
    "\n",
    "def team_metrics(pred, day_mask, gkeys=None):\n",
    "    t = A[day_mask].assign(p=pred[day_mask])\n",
    "    if gkeys is not None: t = t[t['gkey'].isin(gkeys)]\n",
    "    # 업종×일\n",
    "    d = t.groupby(['gkey', '날짜'])[['y', 'p']].sum()\n",
    "    mae = 1 - (d['y'] - d['p']).abs().mean() / d['y'].abs().mean()\n",
    "    rmse = 1 - np.sqrt(((d['y'] - d['p']) ** 2).mean()) / np.sqrt((d['y'] ** 2).mean())\n",
    "    # 업종별 합산: 기간 매출 차이율\n",
    "    Bd = t.drop_duplicates(['gkey', '날짜']).groupby('gkey')['B_하루합'].sum()\n",
    "    g = pd.DataFrame({'실제': (t['S'] - t['B']).groupby(t['gkey']).sum() / Bd,\n",
    "                      '예측': (t['p'] * t['B_하루합']).groupby(t['gkey']).sum() / Bd}).dropna()\n",
    "    k = max(1, int(round(len(g) * 0.1)))\n",
    "    top = len(set(g.nsmallest(k, '실제').index) & set(g.nsmallest(k, '예측').index))\n",
    "    return {'MAE 개선율(%)': mae * 100, '순위상관': g['실제'].corr(g['예측'], method='spearman'),\n",
    "            'RMSE 개선율(%)': rmse * 100, '상위10% 겹침': f'{top}/{k}', '편향(%p)': (g['예측'] - g['실제']).mean() * 100,\n",
    "            '업종 수': len(g), '업종×일 수': len(d)}\n",
    "\n",
    "DAYS = {'특보일': A['특보일'].to_numpy(), '폭염일': (A['폭염등급'] > 0).to_numpy(), '호우일': (A['호우등급'] > 0).to_numpy()}\n",
    "ALL_G = A['gkey'].unique()\n",
    "GROUPS = {'전체 업종': None, '분석범위 업종 제외': VOL.index[~VOL['분석범위검토']]}\n",
    "for gr in ['저변동', '중변동', '고변동']: GROUPS[gr] = VOL.index[VOL['변동성등급'] == gr]\n",
    "\n",
    "rows = []\n",
    "for name, p in PRED.items():\n",
    "    for dlab, dm in DAYS.items():\n",
    "        for glab, gk in GROUPS.items():\n",
    "            if dlab != '특보일' and glab not in ('전체 업종',): continue\n",
    "            rows.append({'손실함수': name, '날짜': dlab, '업종 범위': glab, **team_metrics(p, dm, gk)})\n",
    "TEAM = pd.DataFrame(rows)\n",
    "MAIN = TEAM[(TEAM['날짜'] == '특보일') & (TEAM['업종 범위'] == '전체 업종')].set_index('손실함수')\n",
    "print('[주 결과] 특보일 · 전체 업종'); display(MAIN.drop(columns=['날짜', '업종 범위']).round(3))\n",
    "print('[손실함수별 · 업종 범위별] 특보일'); display(TEAM[TEAM['날짜'] == '특보일'].pivot(index='업종 범위', columns='손실함수',\n",
    "        values=['MAE 개선율(%)', '순위상관', '상위10% 겹침', '편향(%p)']).reindex(list(GROUPS)).round(3))\n",
    "print('[폭염일 / 호우일 따로] 전체 업종'); display(TEAM[TEAM['업종 범위'] == '전체 업종'].set_index(['날짜', '손실함수'])\n",
    "        .drop(columns=['업종 범위']).round(3))\n",
    "\n",
    "# 손실 함수 선택: 주 지표 두 개(MAE 개선율, 순위상관)의 순위 평균이 가장 좋은 것. 같으면 MAE 우선\n",
    "rk = MAIN['MAE 개선율(%)'].rank(ascending=False) + MAIN['순위상관'].rank(ascending=False)\n",
    "BEST = sorted(MAIN.index, key=lambda n: (rk[n], -MAIN.loc[n, 'MAE 개선율(%)']))[0]\n",
    "print(f'▶ 주 지표 두 개 기준 손실 함수: {BEST}')\n",
    "pl = ~A['특보일'].to_numpy()\n",
    "print('[참고] 평시 업종×일 MAE 개선율(%) — 0 근처면 정상(없는 효과를 만들지 않음):',\n",
    "      {n: round(team_metrics(p, pl)['MAE 개선율(%)'], 2) for n, p in PRED.items()})\n",
    "TEAM.to_csv(f'{OUT_DIR}/39_팀평가지표.csv', index=False, encoding='utf-8-sig')\n",
    "\n",
    "A['y_hat']=PRED['Huber']\n",
    "\n",
    "# 아래는 원본 예측을 유지하고 집계·검증을 수정한 부분입니다.\n",
    "# 평시 기간범위는 원본 RNG 순서를 보존. Impact용 추출은 별도 RNG.\n",
    "rng=np.random.default_rng(SEED)\n",
    "rng_impact=np.random.default_rng(SEED)\n",
    "POOLS={g:{w:q for w,q in z.groupby('요일')} for g,z in D[POOL].groupby('gkey')}\n",
    "def placebo(gkey,dates,win=3):\n",
    "    draws=np.full((len(dates),N_DRAW),np.nan);ds=np.zeros(N_DRAW);bs=np.zeros(N_DRAW)\n",
    "    for j,d in enumerate(dates):\n",
    "        q=POOLS.get(gkey,{}).get(d.dayofweek)\n",
    "        if q is None or q.empty: raise ValueError(f'평시 요일 표본 없음: {gkey} {d}')\n",
    "        ix=rng.integers(0,len(q),N_DRAW)\n",
    "        ds+=(q['S'].to_numpy()-q['B'].to_numpy())[ix];bs+=q['B'].to_numpy()[ix]\n",
    "        draws[j]=q['y_day'].to_numpy()[ix]\n",
    "    return (*np.percentile(ds/bs,[5,95]),draws)\n",
    "def impact_null(gkey,full_dates,valid_dates,win):\n",
    "    # 에피소드와 같은 달력 위치/결측 마스크에 요일별 평시 값을 배치.\n",
    "    a=np.full((len(full_dates),N_DRAW),np.nan)\n",
    "    for j,d in enumerate(full_dates):\n",
    "        if d not in valid_dates:continue\n",
